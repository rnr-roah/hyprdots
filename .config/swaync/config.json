{
  "$schema": "/etc/xdg/swaync/configschema.json",

  "positionX": "center",
  "positionY": "top",
  "control-center-margin-top": 0,
  "control-center-exclusive-zone": false,
  "control-center-layer": "overlay",
  "layer": "overlay",
  "layer-shell": true,

  "cssPriority": "user",
  "fit-to-screen":  true,
  "control-center-width": 600,

  "notification-window-width": 400,
  "notification-icon-size": 40,
  "notification-body-image-height": 600,
  "notification-body-image-width": 500,
  "notification-inline-replies": true,
  "notification-2fa-action": true,

  "timeout": 4,
  "timeout-low": 2,
  "timeout-critical": 6,

  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": false,
  "script-fail-notify": true,

  "notification-sound": true,
  "notification-sound-file": "",
  "notification-sound-command": "canberra-gtk-play -i message",

  "widgets": [
    "buttons-grid",
    "backlight",
    "volume",
    "title",
    "dnd",
    "notifications"
  ],

  "widget-config": {
    "title": {
    "text": "Notifications",
    "clear-all-button": true,
    "button-text": "Clear All"
  },
  "notifications": {
    "text-empty": ""
},
    "backlight": {
      "device": "intel_backlight",
      "label": "󰃠",
      "slider": true,
      "min": 5
    },
    "volume": {
      "device": "default",
      "label": "",
      "slider": true
    },
    "dnd": {
      "text": "Do not disturb"
    },
    "mpris": {
      "image-size": 58,
      "image-radius": 12,
      "autohide": true,
      "blacklist": ["org.mpris.MediaPlayer2.playerctld"]
    },
    "buttons-grid": {
      "actions": [
        {
          "label": "󰌪",
          "type": "toggle",
          "command": "bash -c '$HOME/.config/waybar/bars/minimal/start.sh; powerprofilesctl set power-saver'",
          "update-command": "bash -c '[[ $SWAYNC_TOGGLE_STATE == true ]] && $HOME/.config/swaync/scripts/update_quiet.sh'"
        },
        {
          "label": "",
          "type": "toggle",
          "command": "bash -c '$HOME/.config/swaync/scripts/inhibit.sh'",
          "update-command": "bash -c '[[ $SWAYNC_TOGGLE_STATE == true ]] && $HOME/.config/swaync/scripts/update_inhibit.sh'"
        },
        {
          "label": "",
          "type": "toggle",
          "command": "pactl set-source-mute @DEFAULT_SOURCE@ toggle",
          "update-command": "bash -c '[[ $SWAYNC_TOGGLE_STATE == true ]] && $HOME/.config/swaync/scripts/update_mic.sh'"
        },
        {
          "label": "",
          "command": "hyprctl dispatch exec alacritty -- -e htop ; swaync-client -cp"
        },
        {
          "label": "",
          "command": "hyprctl dispatch exec alacritty -- -e nvtop ; swaync-client -cp"
        },
        {
          "label": "",
          "command": "hyprctl dispatch exec nwg-look ; swaync-client -cp"
        },
        {
          "label": "",
          "command": "swaync-client -cp ; hyprlock"
        }
      ]
    }
  }
}
