/* Roah SwayNC — Matugen glass setup
   Uses ~/.config/waybar/colors.css
*/
@import "../waybar/colors.css";

@define-color background       alpha(@primary_container, 0.22);
@define-color background-alt   alpha(@surface_variant, 0.62);
@define-color card             alpha(@primary_container, 0.28);
@define-color solid-card       alpha(@primary_container, 0.82);
@define-color solid-card-2     alpha(@surface_variant, 0.88);
@define-color text             @on_surface_variant;
@define-color text-alt         alpha(@on_surface_variant, 0.72);
@define-color selected         alpha(@primary, 0.48);
@define-color hover            alpha(@primary, 0.28);
@define-color urgent           @primary;
@define-color border           alpha(@primary, 0.22);

* {
  all: unset;
  color: @text;
  font-size: 14px;
  font-family: "CaskaydiaCove Nerd Font Propo";
  font-weight: 700;
  transition: 200ms ease;
}

.blank-window {
  background: transparent;
}

/* Parent panel: fully transparent */
.control-center,
.control-center > box,
.control-center > viewport,
.control-center > scrolledwindow,
.control-center scrolledwindow,
.control-center viewport {
  background: transparent;
  border: none;
  box-shadow: none;
}

.control-center {
  border-radius: 0;
  margin: 10px;
  margin-top: 0px;
  padding: 12px;
}

/* ═══════════════════════════════════════════════════════
   CARD 1 : QUICK SETTINGS
   buttons-grid + brightness + volume
   ═══════════════════════════════════════════════════════ */

.widget-buttons-grid {
  border-radius: 18px 18px 0 0;
  padding: 8px;
  margin: 0;
  background: alpha(@surface, 0.7);
  border: 1px solid alpha(@primary, 0.1);
  border-bottom: none;
  color: @text;
}

.widget-buttons-grid button {
  padding: 10px 14px;
  margin: 3px;
  background: alpha(@primary_container, 0.58);
  border: 1px solid alpha(@primary, 0.22);
  border-radius: 15px;
}

.widget-buttons-grid button > label {
  color: @text;
  font-size: 16px;
}

.widget-buttons-grid button:hover {
  background: alpha(@primary, 0.35);
}

.widget-buttons-grid button:checked {
  background: alpha(@primary, 0.55);
}

.widget-buttons-grid button:checked > label {
  color: @on_primary;
}

.widget-backlight {
  padding: 8px 14px;
  margin: 0;
  border-radius: 0;
  /* background: alpha(@surface_variant, 0.68); */
  /* border-left: 1px solid alpha(@primary, 0.28); */
  /* border-right: 1px solid alpha(@primary, 0.28); */
  background: alpha(@surface, 0.7);
  border-left: 1px solid alpha(@primary, 0.1);
  border-right: 1px solid alpha(@primary, 0.1);
  color: @text;
}

.widget-volume {
  padding: 8px 14px;
  margin: 0 0 18px 0;
  border-radius: 0 0 18px 18px;
  /* background: alpha(@surface_variant, 0.68); */
  background: alpha(@surface, 0.7);
  border: 1px solid alpha(@primary, 0.1);
  border-top: none;
  color: @text;
}

/* Sliders */
.widget-backlight label,
.widget-volume label {
  font-size: 1.05rem;
  margin-right: 8px;
  color: @text;
}

.widget-backlight trough,
.widget-volume trough {
  background: alpha(@on_surface_variant, 0.16);
  margin-left: 8px;
  border-radius: 999px;
  min-height: 7px;
}

.widget-backlight highlight,
.widget-volume highlight {
  background: linear-gradient(90deg, alpha(@primary, 0.76), @primary);
  border-radius: 999px;
  min-height: 7px;
}

.widget-backlight slider,
.widget-volume slider {
  background: @on_primary_container;
  border-radius: 999px;
  min-width: 14px;
  min-height: 14px;
  margin: -5px;
  box-shadow: 0 3px 9px alpha(#000000, 0.35);
}



.widget-title {
  background: alpha(@surface, 0.7);
  border: 1px solid alpha(@primary, 0.1);
  border-bottom: none;
  border-radius: 18px 18px 0 0;
  padding: 10px 14px;
  margin: 0;
}

.widget-title label {
  font-weight: 800;
  font-size: 1rem;
  color: @text;
}

.widget-title button {
  background: alpha(@primary_container, 0.18);
  border: 1px solid alpha(@primary, 0.09);;
  border-radius: 10px;
  padding: 6px 10px;
  color: @text;
}

.widget-title button:hover {
  background: alpha(@primary, 0.42);
}

.widget-dnd {
  padding: 10px 14px;
  border-radius: 0 0 18px 18px;
  margin: 0 0 14px 0;
  background: alpha(@surface, 0.7);
  border: 1px solid alpha(@primary, 0.1);
  border-top: none;
  color: @text;
}

.widget-dnd > label {
  font-size: 1rem;
}

.widget-dnd switch {
  background: alpha(@on_surface_variant, 0.16);
  border-radius: 999px;
  padding: 2px;
}

.widget-dnd switch slider {
  background: @text-alt;
  border-radius: 999px;
}

.widget-dnd switch:checked {
  background: @primary;
}

.widget-dnd switch:checked slider {
  background: @on_primary;
}

.widget-dnd switch:hover,
.control-center .notification-group-collapse-button:hover,
.control-center .notification-group-close-all-button:hover {
  background: @hover;
}

/* MPRIS */
.widget-mpris {
  background: alpha(@surface_variant, 0.58);
  border: 1px solid alpha(@primary, 0.22);
  border-radius: 16px;
  margin: 8px 0;
  padding: 10px;
}

.mpris-overlay {
  background: transparent;
}

.widget-mpris-player {
  background: transparent;
  padding: 8px;
  margin: 0;
}

.widget-mpris-player .mpris-overlay > box:last-child {
  background: transparent;
}

.widget-mpris-album-art {
  border-radius: 14px;
  margin: 4px 12px 4px 4px;
  min-width: 64px;
  min-height: 64px;
}

.widget-mpris-title {
  font-size: 1rem;
  font-weight: 800;
  color: @text;
  margin: 2px 0;
}

.widget-mpris-subtitle {
  font-size: 0.85rem;
  color: @text-alt;
}

.widget-mpris-player button {
  padding: 7px 10px;
  margin: 2px 4px;
  border-radius: 12px;
  background: alpha(@primary_container, 0.38);
}

.widget-mpris-player button:hover {
  background: alpha(@primary, 0.35);
}

.widget-mpris-player button label {
  font-size: 18px;
  color: @text;
}

.widget-mpris-player .image-button:hover {
  border-radius: 12px;
  background: alpha(@primary, 0.30);
}

/* Popup notifications: glassy/translucent */
.notification-background {
  background: transparent;
  border-radius: 16px;
  margin: 8px;
  opacity: 1;
}

.notification {
  padding: 0 5px;
  border-radius: 30px;
  border: 1px solid @border;
  background: @card;
  color: @text;
  opacity: 1;
}


.control-center .notification {
  background: linear-gradient(
    135deg,
    @solid-card,
    @solid-card-2
  );
  border: 2px solid alpha(@primary, 1);
  opacity: 1;
  border-radius: 16px;
}

.control-center .notification .summary,
.control-center .notification .body,
.control-center .notification .time,
.control-center .notification label,
.control-center .notification-content,
.control-center .text-box {
  opacity: 1;
}

.notification .notification-content {
  margin: 10px;
}

.notification-content .text-box {
  margin: 0 0 0 15px;
}

.notification-content .time {
  font-size: 0.9rem;
  padding: 2px 0;
  font-weight: 800;
  color: @text-alt;
}

.notification .summary {
  font-weight: 800;
  margin-bottom: 2px;
  padding: 2px 0;
  font-size: 1rem;
}

.notification .body {
  color: @text-alt;
  font-size: 0.82rem;
}

.notification.critical {
  border-color: @urgent;
}

.notification.low progress,
.notification.normal progress,
.notification.critical progress {
  background: @selected;
}

.notification-row .inline-reply-entry {
  padding: 5px 10px;
  background: @background-alt;
  border-radius: 14px;
}

.notification-row .inline-reply-button,
.notification > *:last-child > * .notification-action {
  padding: 5px 10px;
  border-radius: 12px;
  background: @hover;
}

.notification-row .inline-reply .inline-reply-button:hover,
.notification > *:last-child > * .notification-action:hover,
.notification > *:last-child > * .notification-action:active {
  background: @selected;
}

.notification-background .close-button {
  margin: 6px;
  padding: 2px;
  border-radius: 8px;
  background: transparent;
}

.notification-background .close-button:hover {
  background: @hover;
}

.control-center .notification-background .close-button,
.notification-group-close-button {
  opacity: 0;
}

.notification-group {
  margin: 0px 8px;
  opacity: 1;
}

.notification-group-headers {
  font-weight: bold;
  color: @text;
}

.notification-group-headers > label {
  margin: 0 3px;
  font-size: 1rem;
}

.notification-group-icon {
  color: @text;
}

.notification-group-collapse-button,
.notification-group-close-all-button {
  background: transparent;
  color: @text;
  margin: 4px;
  border-radius: 8px;
  padding: 4px;
}

.control-center-list-placeholder {
  color: @text-alt;
}
