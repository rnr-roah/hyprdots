        command: [
            "sh",
            "-c",
            "wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null | grep -oE '[0-9]+\\.[0-9]+' | head -1 | awk '{print int($1*100)}'"
        ]

        stdout: SplitParser {
